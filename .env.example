# DoorSignal Environment Configuration

# Database (Aurora PostgreSQL Serverless v2 / local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doorsignal

# Ring Partner API & Webhook Configuration
RING_CLIENT_ID=amzn_ring_client_doorsignal_dev
RING_CLIENT_SECRET=ring_partner_oauth_secret_example
RING_WEBHOOK_SECRET=ds_ring_webhook_secret_dev_key
RING_DEVICE_ID_FRONT=ring_dev_front_door_01
RING_DEVICE_ID_DOCK=ring_dev_dock_02

# AWS Infrastructure & Bedrock AgentCore
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
EVENT_BUS_NAME=doorsignal.bus
DEDUP_TABLE_NAME=doorsignal_ring_dedup
MEDIA_BUCKET_NAME=doorsignal-media-ephemeral

# Amazon Bedrock AgentCore Runtime & Models
BEDROCK_AGENT_RUNTIME_ENABLED=true
AGENTCORE_RUNTIME_ENDPOINT=https://bedrock-agentcore.us-east-1.amazonaws.com
AGENTCORE_POLICY_ENFORCEMENT=STRICT
NOVA_MODEL_ID=amazon.nova-lite-v1:0

# Email & Notifications (Amazon SES)
SES_SOURCE_EMAIL=notifications@doorsignal.com
SES_REGION=us-east-1

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Northline Studio
NEXT_PUBLIC_SITE_SLUG=northline
