# DoorSignal local environment
AWS_REGION=us-east-1
APP_URL=http://localhost:3000
DOORSIGNAL_FILE=.data/records.json
DOORSIGNAL_CONFIG=.data/config.json
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# AWS deployment supplies these through CDK. Do not commit their values.
# DOORSIGNAL_TABLE=
# DOORSIGNAL_SECRET_ARN=
# EVENT_BUS_NAME=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=
# SES_FROM=notifications@doorsignal.site
