{
  "name": "doorsignal-monorepo",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @doorsignal/web dev",
    "build": "turbo run build --filter=@doorsignal/web",
    "package:web": "node scripts/package-web.mjs",
    "typecheck": "pnpm --filter @doorsignal/core typecheck && pnpm --filter @doorsignal/web typecheck && pnpm --filter @doorsignal/cdk typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "verify": "pnpm test && pnpm typecheck && pnpm build",
    "infra:synth": "pnpm --filter @doorsignal/cdk synth",
    "secrets:scan": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "@types/node": "^22.13.4",
    "tsx": "^4.20.0",
    "esbuild": "^0.25.0",
    "@types/aws-lambda": "^8.10.0"
  },
  "packageManager": "pnpm@11.22.0"
}
