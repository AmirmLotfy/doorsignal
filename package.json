{
  "name": "doorsignal-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @doorsignal/db db:generate",
    "db:migrate": "pnpm --filter @doorsignal/db db:migrate",
    "db:seed": "pnpm --filter @doorsignal/db db:seed",
    "ring:simulate": "pnpm --filter @doorsignal/ring-client simulate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "@types/node": "^22.13.4"
  },
  "packageManager": "pnpm@11.22.0"
}
